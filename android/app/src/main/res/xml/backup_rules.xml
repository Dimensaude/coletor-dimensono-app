<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing of this app goes to a backup: it holds health data and the patient's session. -->
<full-backup-content>
    <exclude domain="root" />
    <exclude domain="file" />
    <exclude domain="database" />
    <exclude domain="sharedpref" />
    <exclude domain="external" />
</full-backup-content>
